<view class="page page--tab">
  <nav-bar>
    <view slot="left" class="mhead">
      <text class="mhead__m num">{{yearText}}年{{monthNum}}月</text>
    </view>
    <view slot="right" class="macts">
      <view class="mact" hover-class="mact--hover" bindtap="onPrevMonth">
        <ui-icon name="left" size="36" color="#A8ADB5" />
      </view>
      <view class="mact" hover-class="mact--hover" bindtap="onNextMonth">
        <ui-icon name="right" size="36" color="#A8ADB5" />
      </view>
    </view>
  </nav-bar>

  <view class="body">
    <view wx:if="{{updatedText}}" class="updated num">更新至 {{updatedText}}</view>

    <!-- 汇总（主角卡片） -->
    <view class="card card--hero kpis">
      <view class="kpi">
        <text class="kpi__k">支出</text>
        <view class="kpi__v num is-out">
          <text class="kpi__cur">¥</text><text class="kpi__int">{{expenseInt}}</text><text class="kpi__dec">.{{expenseDec}}</text>
        </view>
        <text wx:if="{{diffText}}" class="kpi__diff {{expenseDiffUp ? 'is-up' : 'is-down'}}">{{diffText}}</text>
      </view>
      <view class="kpi">
        <text class="kpi__k">收入</text>
        <view class="kpi__v num is-in">
          <text class="kpi__cur">¥</text><text class="kpi__int">{{incomeInt}}</text><text class="kpi__dec">.{{incomeDec}}</text>
        </view>
      </view>
      <view class="kpi">
        <text class="kpi__k">结余</text>
        <view class="kpi__v num">
          <text class="kpi__cur">{{balanceNegative ? '-¥' : '¥'}}</text><text class="kpi__int">{{balanceInt}}</text><text class="kpi__dec">.{{balanceDec}}</text>
        </view>
      </view>
    </view>

    <!-- 每日支出 -->
    <view class="card chart">
      <view class="card__head">
        <text class="card__title">每日支出</text>
      </view>

      <view class="bars-wrap">
        <view class="bars">
          <view
            wx:for="{{bars}}"
            wx:key="day"
            class="bar-col"
            data-day="{{item.day}}"
            data-text="{{item.valueText}}"
            bindtap="onBarTap"
          >
            <view
              wx:if="{{item.today && item.value > 0}}"
              class="bar-val num"
              style="bottom:{{item.h}}rpx;"
            >¥{{item.valueText}}</view>
            <view
              class="bar {{item.isEmpty ? 'is-empty' : ''}} {{item.isFuture ? 'is-future' : ''}} {{item.today ? 'is-today' : ''}}"
              style="height:{{item.h}}rpx;"
            ></view>
          </view>
        </view>
        <view wx:if="{{avgLineBottom > 2}}" class="avgline" style="bottom:{{avgLineBottom}}rpx;">
          <text class="avgline__txt num">日均 ¥{{dailyAvgText}}</text>
        </view>
      </view>

      <view class="scale">
        <text>1日</text>
        <text>8日</text>
        <text>15日</text>
        <text>22日</text>
        <text>{{daysInMonth}}日</text>
      </view>
    </view>

    <!-- 分类构成 -->
    <view class="card cat">
      <view class="card__head">
        <text class="card__title">{{drillCode ? drillName : '分类构成'}}</text>
        <view class="seg cat__seg">
          <view class="seg__item {{seg === 0 ? 'is-on' : ''}}" data-seg="0" bindtap="onSegTap">支出</view>
          <view class="seg__item {{seg === 1 ? 'is-on' : ''}}" data-seg="1" bindtap="onSegTap">收入</view>
        </view>
      </view>

      <view class="cat__body">
        <view class="cat__chart">
          <donut-chart items="{{chartItems}}" centerText="{{totalText}}" />
        </view>

        <view class="cat__legend">
          <view
            wx:for="{{legend}}"
            wx:key="code"
            class="lg"
            hover-class="{{item.drillable ? 'lg--hover' : ''}}"
            data-code="{{item.drillable ? item.code : ''}}"
            bindtap="onDrillTap"
          >
            <view class="lg__dot" style="background-color:{{item.color}};"></view>
            <text class="lg__name">{{item.name}}</text>
            <text class="lg__ratio num">{{item.ratioText}}</text>
            <text class="lg__amt num">¥{{item.amountText}}</text>
          </view>
          <view wx:if="{{!legend.length}}" class="cat__empty">本月还没有{{seg === 1 ? '收入' : '支出'}}</view>
        </view>
      </view>

      <view wx:if="{{drillCode}}" class="cat__back" bindtap="onDrillBack">
        <ui-icon name="back" size="28" color="#A8ADB5" />
        <text>返回全部分类</text>
      </view>
    </view>

    <!-- 消费洞察（AI 紫） -->
    <view class="ai">
      <view class="ai__head">
        <view class="ai__ico">
          <ui-icon name="spark" size="28" color="#A78BFA" />
        </view>
        <text class="ai__title">消费洞察</text>
        <text class="ai__sub">共 {{billCount}} 笔</text>
      </view>
      <view wx:for="{{insights}}" wx:key="key" class="ai__item">
        <view class="ai__bullet"></view>
        <text class="ai__text">{{item.text}}</text>
      </view>
      <view wx:if="{{!insights.length}}" class="ai__empty">本月还没有足够的数据，先记几笔吧。</view>
    </view>

    <view class="foot">收支以入账日期为准</view>
  </view>
</view>
