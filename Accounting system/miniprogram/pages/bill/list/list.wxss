/**
 * 日历账本（设计稿 02 屏）
 */
.page {
  min-height: 100vh;
  padding-bottom: 220rpx;
  background: radial-gradient(120% 55% at 50% 0%, #131417 0%, #0B0B0C 44%, #08090A 100%);
}

.body {
  padding: 8rpx 32rpx 0;
}

/* ---- 顶部月份 ---- */

.mhead {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.mhead__m {
  font-family: var(--font-brush);
  font-size: 44rpx;
  color: #F0F0EE;
  letter-spacing: .06em;
}

.mhead__y {
  font-size: 20rpx;
  color: #62636A;
  letter-spacing: .1em;
}

.macts {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mact {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.mact--hover {
  background-color: rgba(255, 255, 255, .06);
}

/* ---- 月历 ---- */

.cal {
  margin-top: 16rpx;
  padding: 24rpx 10rpx 16rpx;
  background-color: #101113;
  border: 1rpx solid rgba(255, 255, 255, .04);
  border-radius: 40rpx;
}

.cal__head {
  display: flex;
  padding: 0 6rpx 12rpx;
}

.cal__wh {
  flex: 1;
  text-align: center;
  font-size: 19rpx;
  color: #5A5B62;
  letter-spacing: .1em;
}

.cal__grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 14.285%;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 22rpx;
  padding: 6rpx 0;
}

.cell.is-blank {
  pointer-events: none;
}

.cell__day {
  font-family: var(--font-sans);
  font-size: 26rpx;
  color: #C9CAC6;
  line-height: 1.2;
}

.cell.is-today .cell__day {
  color: #6FA6FF;
}

.cell__amt {
  font-size: 17rpx;
  color: #5E5F66;
  letter-spacing: -.02em;
  line-height: 1.2;
}

.cell__dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background-color: #3A3B42;
}

.cell.is-on {
  background-color: #182539;
  box-shadow: inset 0 0 0 1rpx rgba(61, 139, 255, .35);
}

.cell.is-on .cell__day {
  color: #EDF3FF;
}

.cell.is-on .cell__amt {
  color: #8AB6FF;
}

/* ---- 分段 ---- */

.seg {
  margin-top: 20rpx;
}

/* ---- 当日概览 ---- */

.nowline {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 4rpx 14rpx;
}

.nowline__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #3D8BFF;
  box-shadow: 0 0 12rpx rgba(61, 139, 255, .8);
}

.nowline__text {
  font-size: 21rpx;
  color: #7B7C82;
  letter-spacing: .06em;
}

.nowline__out {
  margin-left: auto;
  font-size: 21rpx;
  color: #8A8B92;
}

/* ---- 当日流水 ---- */

.daycard {
  padding: 24rpx 28rpx 12rpx;
  background: linear-gradient(165deg, #191A1D, #141518 70%);
  border: 1rpx solid rgba(255, 255, 255, .06);
  border-radius: 40rpx;
}

.daycard__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed rgba(255, 255, 255, .07);
}

.daycard__title {
  font-size: 30rpx;
  color: #E4E5E1;
  letter-spacing: .1em;
}

.daycard__sub {
  font-size: 20rpx;
  color: #5E5F66;
}

.tx {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, .04);
}

.tx:last-child {
  border-bottom: none;
}

.tx--hover {
  opacity: .72;
}

.tx__ico {
  width: 68rpx;
  height: 68rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background-color: #1C1D20;
  border: 1rpx solid rgba(255, 255, 255, .04);
}

.tx__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tx__name {
  font-size: 26rpx;
  color: #DCDDD9;
  letter-spacing: .02em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tx__meta {
  font-size: 19rpx;
  color: #5E5F66;
  letter-spacing: .04em;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tx__amt {
  flex: none;
  font-size: 27rpx;
  color: #D3D4D0;
  letter-spacing: .01em;
}

.tx__amt.is-in {
  color: #8FE0BE;
}

.tx-empty {
  padding: 44rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #4E4F56;
  letter-spacing: .08em;
}

/* ---- AI 洞察 ---- */

.insight {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background-color: rgba(139, 108, 255, .06);
  border: 1rpx solid rgba(139, 108, 255, .14);
}

.insight__ico {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(139, 108, 255, .16);
}

.insight__text {
  font-size: 23rpx;
  line-height: 1.6;
  color: #A9A0C8;
  letter-spacing: .02em;
}

.insight__hl {
  color: #C9B8FF;
  padding: 0 4rpx;
}

.mfoot {
  padding: 28rpx 0 48rpx;
  text-align: center;
  font-size: 19rpx;
  color: #46474E;
  letter-spacing: .08em;
}

/* ---- 搜索 ---- */

.search {
  padding-top: 8rpx;
}

.search__field {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 88rpx;
  padding: 0 12rpx 0 26rpx;
  border-radius: 44rpx;
  background-color: #161719;
  border: 1rpx solid rgba(255, 255, 255, .06);
}

.search__input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 26rpx;
  color: #EDEDEC;
}

.search__ph {
  color: #54555B;
}

.search__cancel {
  font-size: 24rpx;
  color: #9A9BA1;
  padding: 10rpx 14rpx;
}

.search__tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx 8rpx;
}

.search__filter {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #9A9BA1;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, .04);
  border: 1rpx solid rgba(255, 255, 255, .06);
}

.search__filter--hover {
  background-color: rgba(61, 139, 255, .12);
}

.search__hint {
  font-size: 19rpx;
  color: #5E5F66;
  letter-spacing: .06em;
}

.search__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 120rpx 0;
  font-size: 22rpx;
  color: #4E4F56;
  letter-spacing: .06em;
}

.sgroup {
  margin-top: 20rpx;
  padding: 20rpx 28rpx 8rpx;
}

.sgroup__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
}

.sgroup__date {
  font-size: 24rpx;
  color: #B9BABF;
  letter-spacing: .06em;
}

.sgroup__count {
  font-size: 19rpx;
  color: #5E5F66;
}
