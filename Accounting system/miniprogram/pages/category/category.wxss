/* 分类管理：顶部统计 + 分类行（分类色，不用红绿蓝） */
.body {
  padding: 32rpx var(--page-x) 0;
}

/* ---------- 顶部统计 ---------- */
.summary {
  padding: 0 4rpx 24rpx;
}

.summary__row {
  display: flex;
  gap: 40rpx;
}

.summary__item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.summary__n {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--text);
}

.summary__k {
  font-size: var(--t-min);
  color: var(--text-2);
}

.summary__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.summary__meta {
  font-size: var(--t-aux);
  color: var(--text-2);
}

.summary__link {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: var(--blue);
}

.summary__link--hover {
  opacity: .7;
}

/* ---------- 分类卡 ---------- */
.cat-card {
  padding: 24rpx;
}

.card__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 8rpx;
}

.card__title {
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--text);
}

.card__aside {
  font-size: var(--t-min);
  color: var(--text-3);
}

.crow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 128rpx;
  border-bottom: 2rpx solid var(--line-soft);
}

.crow:last-child {
  border-bottom: none;
}

.crow--hover {
  background-color: rgba(255, 255, 255, .03);
}

.crow__ico {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}

.crow__main {
  flex: 1;
  min-width: 0;
}

.crow__line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.crow__name {
  font-size: 32rpx;
  color: var(--text);
}

.crow__amt {
  font-size: 32rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.crow__bar {
  height: 8rpx;
  margin-top: 12rpx;
  border-radius: var(--r-pill);
  background-color: rgba(255, 255, 255, .06);
  overflow: hidden;
}

.crow__bar-fill {
  height: 100%;
  border-radius: var(--r-pill);
}

.crow__meta {
  display: block;
  margin-top: 8rpx;
  font-size: var(--t-min);
  color: var(--text-2);
}

/* ---------- 二级 ---------- */
.sub {
  padding: 4rpx 0 12rpx 100rpx;
}

.sub__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
}

.sub__name {
  flex: 1;
  font-size: var(--t-aux);
  color: var(--text-2);
}

.sub__amt {
  font-size: var(--t-aux);
  color: var(--text);
}

.sub__name.is-zero,
.sub__amt.is-zero {
  color: var(--text-3);
}

.sub__loading {
  padding: 16rpx 0;
  font-size: var(--t-min);
  color: var(--text-3);
}

/* ---------- 未使用分类 ---------- */
.unused {
  margin-top: 8rpx;
  border-top: 2rpx solid var(--line);
}

.unused__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 4rpx;
}

.unused__head--hover {
  opacity: .8;
}

.unused__title {
  font-size: var(--t-aux);
  color: var(--text-2);
}

/* 箭头：默认朝下，展开后旋转 180° 朝上 */
.unused__arrow {
  transition: transform .18s ease;
}

.unused__arrow.is-open {
  transform: rotate(180deg);
}

.urow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
}

.urow__ico {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  opacity: .7;
}

.urow__name {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-3);
}

.urow__amt {
  font-size: 30rpx;
  color: var(--text-3);
}

.cat-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: var(--t-aux);
  color: var(--text-3);
}

/* ---------- 学习规则入口 ---------- */
.rules {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: var(--r-card);
  background-color: var(--card);
  border: 2rpx solid var(--card-line);
}

.rules--hover {
  background-color: var(--panel-2);
}

.rules__ico {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background-color: rgba(255, 255, 255, .05);
}

.rules__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.rules__title {
  font-size: 30rpx;
  color: var(--text);
}

.rules__sub {
  margin-top: 4rpx;
  font-size: var(--t-min);
  color: var(--text-2);
}

.tip {
  padding: 24rpx 8rpx 0;
  font-size: var(--t-min);
  line-height: 1.7;
  color: var(--text-3);
}
