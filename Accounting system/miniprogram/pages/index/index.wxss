/**
 * 首页 · AI 对话式记账（设计稿 01 屏）
 */
.screen {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: radial-gradient(120% 60% at 50% 0%, #131417 0%, #0B0B0C 46%, #08090A 100%);
}

/* ---- 顶部品牌 ---- */

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand__avatar {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-brush);
  font-size: 28rpx;
  color: rgba(255, 255, 255, .9);
  background: radial-gradient(circle at 32% 26%, #B9C6FF, #6E7CE0 42%, #2B2C4A 78%, #15161F);
  box-shadow: 0 0 0 1rpx rgba(255, 255, 255, .14);
}

.brand__avatar-img {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

.brand__meta {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.brand__name {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 34rpx;
  letter-spacing: .08em;
  color: #F1F1EE;
  line-height: 1.2;
}

.brand__ai {
  font-family: var(--font-sans);
  font-size: 15rpx;
  letter-spacing: .12em;
  color: #C7B8FF;
  background-color: rgba(139, 108, 255, .16);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.brand__sub {
  font-size: 18rpx;
  color: #5E5F66;
  letter-spacing: .1em;
  line-height: 1.2;
}

/* ---- 对话区 ---- */

.chat {
  flex: 1;
  min-height: 0;
  height: 0;
}

.chat__inner {
  padding: 12rpx 32rpx 24rpx;
}

.msg {
  display: flex;
  flex-direction: column;
  margin-bottom: 22rpx;
}

.msg.is-ai {
  align-items: flex-start;
}

.msg.is-me {
  align-items: flex-end;
}

.bubble {
  max-width: 560rpx;
  background-color: #161719;
  border: 1rpx solid rgba(255, 255, 255, .04);
  border-radius: 8rpx 32rpx 32rpx 32rpx;
  padding: 24rpx 28rpx;
}

.bubble--me {
  background: linear-gradient(150deg, #4F93FF, #2E7BFA 78%);
  border-color: rgba(255, 255, 255, .16);
  border-radius: 32rpx 8rpx 32rpx 32rpx;
  box-shadow: 0 16rpx 36rpx -18rpx rgba(45, 122, 250, .9);
}

.bubble__text {
  font-size: 27rpx;
  line-height: 1.55;
  color: #E2E3DF;
  letter-spacing: .02em;
  word-break: break-all;
}

.bubble--me .bubble__text {
  color: #FFFFFF;
}

.msg__time {
  font-family: var(--font-sans);
  font-size: 17rpx;
  color: #46474E;
  letter-spacing: .06em;
  margin-top: 8rpx;
  padding: 0 8rpx;
}

/* 续费提醒 */

.renew {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background-color: rgba(255, 176, 32, .07);
  border: 1rpx solid rgba(255, 176, 32, .16);
}

.renew__text {
  flex: 1;
  font-size: 21rpx;
  color: #E3B46A;
  letter-spacing: .02em;
}

/* 输入中 */

.bubble--typing {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 26rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #6E6F76;
  animation: blink 1.1s infinite ease-in-out;
}

.dot:nth-child(2) {
  animation-delay: .16s;
}

.dot:nth-child(3) {
  animation-delay: .32s;
}

@keyframes blink {
  0%, 100% { opacity: .25; }
  50% { opacity: 1; }
}

.typing__text {
  font-size: 19rpx;
  color: #5E5F66;
  letter-spacing: .08em;
  margin-left: 6rpx;
}

/* ---- 解析结果卡 ---- */

.parse {
  margin: 6rpx 0 24rpx;
  padding: 28rpx 30rpx 26rpx;
  background: linear-gradient(165deg, #191A1D, #141518 70%);
  border: 1rpx solid rgba(255, 255, 255, .06);
  box-shadow: 0 30rpx 70rpx -40rpx rgba(0, 0, 0, .9);
}

.parse__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.parse__title {
  flex: 1;
  font-size: 21rpx;
  color: #8B8C93;
  letter-spacing: .1em;
}

.parse__conf {
  font-family: var(--font-sans);
  font-size: 19rpx;
  color: #57D9A3;
  letter-spacing: .06em;
}

.parse__conf.is-low {
  color: #FFB020;
}

.parse__amount {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 22rpx 0 20rpx;
}

.parse__cur {
  font-size: 34rpx;
  color: #7B7C82;
}

.parse__val {
  font-size: 88rpx;
  line-height: 1.05;
  letter-spacing: -.02em;
  color: #F4F4F1;
}

.parse__val.is-income {
  color: #57D9A3;
}

.parse__dec {
  font-size: 46rpx;
  color: #9A9B9F;
}

.parse__edit {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-left: auto;
  font-size: 20rpx;
  color: #6E6F76;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, .07);
}

.parse__meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.parse__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 62rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, .04);
}

.parse__row:last-child {
  border-bottom: none;
}

.parse__k {
  font-size: 23rpx;
  color: #6A6B72;
  letter-spacing: .1em;
}

.parse__v {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 25rpx;
  color: #D8D9D5;
}

.parse__v .is-dim {
  color: #5E5F66;
}

.parse__miss {
  font-size: 21rpx;
  color: #FFCE8A;
  background-color: rgba(255, 176, 32, .12);
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.parse__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, .07);
  font-size: 20rpx;
  color: #5E5F66;
  letter-spacing: .04em;
}

.parse__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.parse__btn {
  flex: 1;
  min-height: 82rpx;
  font-size: 26rpx;
  letter-spacing: .1em;
  border-radius: 20rpx;
}

.parse__btn--hover {
  opacity: .82;
}

/* ---- 快捷短语 ---- */

.chips {
  margin-top: 8rpx;
  white-space: nowrap;
}

.chips__inner {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 0 8rpx;
}

.chips__item {
  flex: none;
  font-size: 22rpx;
  color: #A3A4AA;
  letter-spacing: .04em;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, .035);
  border: 1rpx solid rgba(255, 255, 255, .06);
}

.chips__item--hover {
  background-color: rgba(61, 139, 255, .12);
  color: #9EC2FF;
}

.chat__tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 24rpx;
  font-size: 18rpx;
  color: #46474E;
  letter-spacing: .1em;
}

.chat__end {
  height: 8rpx;
}

/* ---- 输入条 ---- */

.inputbar {
  flex: none;
  padding: 12rpx 28rpx 12rpx;
  background: linear-gradient(180deg, rgba(8, 9, 10, 0) 0%, #08090A 34%);
}

.photo {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
  padding: 10rpx 16rpx;
  border-radius: 20rpx;
  background-color: #141518;
  border: 1rpx solid rgba(255, 255, 255, .05);
}

.photo__img {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
}

.photo__text {
  flex: 1;
  font-size: 21rpx;
  color: #8B8C93;
}

.photo__remove {
  font-size: 21rpx;
  color: #FF8B8B;
  padding: 6rpx 12rpx;
}

.ib {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ib__field {
  flex: 1;
  min-width: 0;
  height: 94rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 12rpx 0 22rpx;
  border-radius: 47rpx;
  background-color: #161719;
  border: 1rpx solid rgba(255, 255, 255, .06);
}

.ib__icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.ib__input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 27rpx;
  color: #EDEDEC;
  letter-spacing: .02em;
}

.ib__ph {
  color: #54555B;
  font-size: 26rpx;
}

.ib__send {
  flex: none;
  width: 94rpx;
  height: 94rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1C1D20;
  border: 1rpx solid rgba(255, 255, 255, .06);
  transition: all .2s ease;
}

.ib__send.is-on {
  background: linear-gradient(160deg, #5AA3FF, #2E7BFA 70%);
  border-color: rgba(255, 255, 255, .2);
  box-shadow: 0 18rpx 40rpx -16rpx rgba(45, 122, 250, .9);
}

.ib__send--hover {
  transform: scale(.94);
}

/* ---- 抽屉 ---- */

.scrim {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: #000000;
  z-index: 60;
  transition: opacity .26s ease;
}

.scrim.is-drag {
  transition: none;
}

.drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  width: 624rpx;
  z-index: 70;
  padding-top: calc(env(safe-area-inset-top) + 40rpx);
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #0C0D0E;
  border-right: 1rpx solid rgba(255, 255, 255, .06);
  box-shadow: 40rpx 0 80rpx rgba(0, 0, 0, .6);
  transition: transform .28s cubic-bezier(.32, .82, .28, 1);
  box-sizing: border-box;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.drawer.is-drag {
  transition: none;
}
