/* 日历页：月份标题 + 紧凑月历 + 当日明细（主角卡片） */

/* filter-panel 挂在页面根下（不在 .page--tab 内），
   变量必须声明在 page 上才能继承，否则筛选弹层的按钮会被 tab 栏盖住 */
page {
  --sheet-bottom: calc(var(--tab-h) + var(--safe-b));
  --sheet-safe: 0px;
}

.body {
  padding: 8rpx var(--page-x) 0;
}

/* ---------- 月份 ---------- */
.mhead {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.mhead__m {
  font-size: var(--t-h1);
  font-weight: 600;
  color: var(--text);
  line-height: 1.2;
}

.macts {
  display: flex;
  align-items: center;
}

.mact {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.mact--hover {
  background-color: rgba(255, 255, 255, .05);
}

/* ---------- 搜索 ---------- */
.search {
  margin-bottom: 24rpx;
}

.search__field {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--r-btn);
  background-color: var(--card);
  border: 2rpx solid var(--card-line);
}

.search__input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: var(--text);
}

.search__ph {
  color: var(--text-3);
}

.search__cancel {
  min-width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: var(--text-2);
}

.search__tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.search__filter {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--r-pill);
  background-color: var(--card);
  border: 2rpx solid var(--card-line);
  font-size: 26rpx;
  color: var(--text-2);
}

.search__filter--hover {
  opacity: .8;
}

.search__hint {
  font-size: 24rpx;
  color: var(--text-3);
}

.search__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 96rpx 0;
  font-size: 28rpx;
  color: var(--text-3);
}

.sgroup {
  margin-bottom: 24rpx;
  padding: 8rpx 24rpx;
}

.sgroup__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}

.sgroup__date {
  font-size: var(--t-aux);
  color: var(--text-2);
}

.sgroup__count {
  font-size: var(--t-min);
  color: var(--text-3);
}

/* ---------- 月历 ---------- */
.cal__seg {
  margin: 8rpx 0 24rpx;
}

.cal {
  padding: 24rpx 20rpx 12rpx;
}

.cal__head {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding-bottom: 12rpx;
}

.cal__wh {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
}

.cal__grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx 0;
}

.cell {
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.cell.is-blank {
  border-color: transparent;
}

.cell.is-today {
  border-color: var(--blue);
}

.cell.is-on {
  background-color: var(--blue-weak);
  border-color: var(--blue);
}

.cell__day {
  font-size: 32rpx;
  line-height: 1.2;
  color: var(--text);
}

.cell__day.is-on {
  color: var(--blue);
  font-weight: 600;
}

.cell__amt {
  margin-top: 2rpx;
  font-size: var(--t-cal);
  line-height: 1.2;
  color: var(--text-2);
}

.cell__dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background-color: var(--text-3);
}

/* ---------- 当日明细 ---------- */
.daycard {
  margin-top: 24rpx;
  padding: 24rpx;
}

.daycard__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 8rpx;
}

.daycard__title {
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--text);
}

.daycard__sub {
  font-size: var(--t-min);
  color: var(--text-3);
}

/* ---------- 明细行 ---------- */
.tx {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 12rpx 0;
  border-radius: 16rpx;
}

.tx--hover {
  background-color: rgba(255, 255, 255, .03);
}

.tx__ico {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.tx__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.tx__name {
  font-size: var(--t-body);
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tx__meta {
  margin-top: 4rpx;
  font-size: var(--t-min);
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tx__amt {
  flex: none;
  font-size: var(--t-body);
  font-weight: 600;
  color: var(--text);
}

.tx__amt.is-in {
  color: var(--income);
}

.tx-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: var(--t-aux);
  color: var(--text-3);
}

/* ---------- 洞察 ---------- */
.insight {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: var(--r-card);
  background-color: var(--ai-weak);
  border: 2rpx solid rgba(167, 139, 250, .16);
}

.insight__ico {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.insight__text {
  flex: 1;
  font-size: var(--t-aux);
  line-height: 1.6;
  color: var(--text-2);
}

.insight__hl {
  color: var(--ai);
}

.mfoot {
  padding: 32rpx 0 8rpx;
  text-align: center;
  font-size: var(--t-min);
  color: var(--text-3);
}
