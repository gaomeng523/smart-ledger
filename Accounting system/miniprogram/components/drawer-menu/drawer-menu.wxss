/* 我的：头部 + 月度报告 + 三组菜单 */
.dm {
  padding: 24rpx var(--page-x) calc(var(--tab-h) + var(--safe-b) + 48rpx);
}

.dm--page {
  padding-bottom: calc(var(--tab-h) + env(safe-area-inset-bottom) + 48rpx);
}

/* ---------- 头部 ---------- */
.prof {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0 32rpx;
}

.prof__avatar {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex: none;
  border-radius: 50%;
  overflow: hidden;
  background-color: rgba(76, 141, 255, .14);
  border: 2rpx solid rgba(255, 255, 255, .08);
}

.prof__avatar-img {
  width: 100%;
  height: 100%;
}

.prof__avatar-txt {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--blue);
}

.prof__avatar-btn {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}

.prof__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.prof__name {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.prof__tip {
  margin-top: 8rpx;
  font-size: var(--t-min);
  color: var(--text-2);
}

/* 游客态：我的 / 抽屉里的登录入口（用户主动点击） */
.prof__login {
  margin-top: 12rpx;
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background-color: rgba(76, 141, 255, .12);
  border: 2rpx solid rgba(76, 141, 255, .28);
}

.prof__login--hover {
  opacity: .7;
}

.prof__login-txt {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--blue);
}

.prof__stats {
  flex: none;
  display: flex;
  gap: 32rpx;
}

.pstat {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.pstat__n {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--text);
}

.pstat__k {
  margin-top: 4rpx;
  font-size: var(--t-min);
  color: var(--text-3);
}

/* ---------- 月度报告 ---------- */
.report {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--r-card);
  background: linear-gradient(150deg, rgba(167, 139, 250, .16) 0%, rgba(167, 139, 250, .06) 58%, rgba(255, 255, 255, .02) 100%);
  border: 2rpx solid rgba(167, 139, 250, .18);
}

.report--hover {
  transform: scale(.99);
}

.report__ico {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background-color: rgba(167, 139, 250, .14);
}

.report__main {
  flex: 1;
  min-width: 0;
}

.report__title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.report__title {
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--text);
}

.report__new {
  height: 32rpx;
  padding: 0 10rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 8rpx;
  font-size: var(--t-min);
  font-weight: 600;
  letter-spacing: .5px;
  color: var(--ai);
  background-color: rgba(167, 139, 250, .16);
}

.report__sub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
}

/* ---------- 分组 ---------- */
.group {
  margin-top: 32rpx;
}

.group__title {
  padding: 0 8rpx 12rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
}

.group__card {
  padding: 0 24rpx;
}

.mrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  border-bottom: 2rpx solid var(--line-soft);
}

.mrow:last-child {
  border-bottom: none;
}

.mrow--hover {
  background-color: rgba(255, 255, 255, .03);
}

.mrow__label {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  color: var(--text);
}

.mrow__value {
  font-size: 30rpx;
  color: var(--text-2);
}

.dm__foot {
  padding: 40rpx 0 8rpx;
  text-align: center;
  font-size: var(--t-min);
  color: var(--text-3);
}
