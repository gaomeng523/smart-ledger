/* 模板管理：区块标题 + 模板卡片列表 */
.body {
  padding: 32rpx var(--page-x) 0;
}

.hint {
  padding: 0 4rpx 16rpx;
  font-size: var(--t-min);
  color: var(--text-3);
}

.tpl-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ---------- 撤销条 ---------- */
.undo {
  position: fixed;
  left: var(--page-x);
  right: var(--page-x);
  bottom: calc(env(safe-area-inset-bottom) + 32rpx);
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: var(--r-btn);
  background-color: var(--raised);
  border: 2rpx solid var(--card-line);
}

.undo__text {
  font-size: var(--t-aux);
  color: var(--text);
}

.undo__btn {
  min-width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: var(--t-aux);
  font-weight: 600;
  color: var(--blue);
}

.undo__btn--hover {
  opacity: .7;
}

/* ---------- 半屏弹窗 ---------- */
.sheet__mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background-color: rgba(0, 0, 0, .6);
}

.sheet__panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 81;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  background-color: var(--card);
  border-radius: var(--r-card) var(--r-card) 0 0;
  border-top: 2rpx solid var(--card-line);
}

.sheet__header {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 0;
}

.sheet__title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}

.sheet__close {
  /* 热区 88rpx × 88rpx，文字右边缘与内容保持 32rpx 边距 */
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: var(--text-3);
}

.sheet__close--hover {
  opacity: .7;
}

.sheet__body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 32rpx;
}

.sheet__field {
  margin-bottom: 24rpx;
}

.sheet__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
}

.sheet__input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background-color: var(--card-2);
  border: 2rpx solid var(--card-line);
  font-size: 30rpx;
  color: var(--text);
}

.sheet__ph {
  color: var(--text-3);
}

.sheet__footer {
  flex: none;
  padding: 16rpx 32rpx;
}

.sheet__save {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  background-color: var(--blue);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.sheet__safe {
  flex: none;
  height: env(safe-area-inset-bottom);
}
