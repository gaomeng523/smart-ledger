<view class="nav" style="padding-top:{{statusBarHeight}}px;">
  <view class="nav__bar" style="height:{{barHeight}}px;padding-right:{{rightSpace}}px;">
    <view wx:if="{{back}}" class="nav__back" hover-class="nav__back--hover" bindtap="onBack">
      <ui-icon name="back" size="36" color="#A8ADB5" />
    </view>

    <view wx:if="{{title}}" class="nav__title">{{title}}</view>
    <slot name="left"></slot>
    <view class="nav__spacer"></view>
    <slot name="right"></slot>
  </view>
</view>
