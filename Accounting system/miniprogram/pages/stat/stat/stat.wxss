/* 统计页：月度汇总（主角卡片）+ 每日柱图 + 分类环图 + 洞察 */
.body {
  padding: 0 var(--page-x);
}

/* 更新时间：12px 次要色单行，紧贴汇总卡上方 */
.updated {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text-3);
  white-space: nowrap;
}

/* ---------- 月份 ---------- */
.mhead {
  display: flex;
  align-items: center;
  min-width: 0;
}

.mhead__m {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--text);
  white-space: nowrap;
}

.macts {
  display: flex;
  align-items: center;
}

.mact {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.mact--hover {
  background-color: rgba(255, 255, 255, .05);
}

/* ---------- 汇总 ---------- */
.kpis {
  display: flex;
  align-items: flex-start;
  margin-top: 32rpx;
  padding: 32rpx 24rpx;
}

.kpi {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 8rpx;
}

.kpi__k {
  font-size: var(--t-min);
  color: var(--text-2);
}

.kpi__v {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--text);
}

.kpi__cur {
  font-size: 24rpx;
  font-weight: 500;
  margin-right: 2rpx;
  color: var(--text-2);
}

.kpi__dec {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-2);
}

.kpi__v.is-out {
  color: var(--expense);
}

.kpi__v.is-in {
  color: var(--income);
}

.kpi__diff {
  margin-top: 8rpx;
  font-size: var(--t-min);
  color: var(--text-3);
}

.kpi__diff.is-up {
  color: var(--expense);
}

.kpi__diff.is-down {
  color: var(--income);
}

/* ---------- 图表卡片 ---------- */
.card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
}

.card__title {
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--text);
}

.card__aside {
  font-size: var(--t-min);
  color: var(--text-3);
}

.chart {
  margin-top: 32rpx;
}

.bars-wrap {
  position: relative;
  height: 264rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
}

.bars {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 100%;
}

.bar-col {
  position: relative;
  flex: 1;
  min-width: 16rpx;
  height: 100%;
  display: flex;
  align-items: flex-end;
}

/* 当天金额：默认展示在当天柱子正上方 */
.bar-val {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  padding-bottom: 8rpx;
  font-size: 20rpx;
  line-height: 1;
  color: var(--text);
  white-space: nowrap;
}

.bar {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  background-color: var(--blue-40);
}

.bar.is-today {
  background-color: var(--blue);
}

.bar.is-empty {
  background-color: transparent;
  border-bottom: 2rpx solid rgba(255, 255, 255, .08);
  border-radius: 0;
}

.bar.is-future {
  background-color: transparent;
  border-bottom: 2rpx dashed rgba(255, 255, 255, .10);
  border-radius: 0;
}

.avgline {
  position: absolute;
  left: 0;
  right: 0;
  border-top: 1rpx dashed rgba(255, 255, 255, .2);
  pointer-events: none;
}

.avgline__txt {
  position: absolute;
  right: 0;
  top: -34rpx;
  font-size: var(--t-min);
  color: var(--text-3);
}

.scale {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: var(--t-min);
  color: var(--text-3);
}

/* ---------- 分类构成 ---------- */
.cat {
  margin-top: 32rpx;
}

.cat__seg {
  width: 220rpx;
}

.cat__seg .seg__item {
  min-height: 56rpx;
  font-size: var(--t-min);
}

.cat__body {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.cat__chart {
  width: 260rpx;
  height: 260rpx;
  flex: none;
}

.cat__legend {
  flex: 1;
  min-width: 0;
}

.lg {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 80rpx;
  border-radius: 12rpx;
}

.lg--hover {
  opacity: .75;
}

.lg__dot {
  width: 20rpx;
  height: 20rpx;
  flex: none;
  border-radius: 50%;
}

.lg__name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lg__ratio {
  width: 64rpx;
  text-align: right;
  font-size: var(--t-min);
  color: var(--text-3);
}

.lg__amt {
  width: 130rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--text);
}

.cat__empty {
  padding: 24rpx 0;
  font-size: var(--t-aux);
  color: var(--text-3);
}

.cat__back {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  margin-top: 8rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
}

/* ---------- 消费洞察 ---------- */
.ai {
  margin-top: 32rpx;
  padding: 32rpx;
  border-radius: var(--r-card);
  background-color: var(--ai-weak);
  border: 2rpx solid rgba(167, 139, 250, .16);
}

.ai__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ai__ico {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai__title {
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--text);
}

.ai__sub {
  margin-left: auto;
  font-size: var(--t-min);
  color: var(--text-3);
}

.ai__item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
}

.ai__bullet {
  width: 8rpx;
  height: 8rpx;
  flex: none;
  margin-top: 16rpx;
  border-radius: 50%;
  background-color: var(--ai);
}

.ai__text {
  flex: 1;
  font-size: var(--t-aux);
  line-height: 1.6;
  color: var(--text-2);
}

.ai__empty {
  margin-top: 16rpx;
  font-size: var(--t-aux);
  color: var(--text-3);
}

.foot {
  padding: 32rpx 0 8rpx;
  text-align: center;
  font-size: var(--t-min);
  color: var(--text-3);
}
