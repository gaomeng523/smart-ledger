.donut {
  position: relative;
  width: 100%;
  height: 100%;
}

.donut__canvas {
  width: 100%;
  height: 100%;
}

.donut__center {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.donut__center-label {
  font-size: var(--t-min, 24rpx);
  color: var(--text-3, #8A8F98);
}

.donut__center-value {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text, #F2F3F5);
  font-variant-numeric: tabular-nums;
}
