/**
 * 全局设计令牌（暗色 · 克制版）
 * 约定：1px = 2rpx；页面样式只引用变量，不写死色值与字号。
 */
page {
  /* ---- 背景与卡片 ---- */
  --bg: #0B0C0E;
  --card: #15171B;
  --card-line: rgba(255, 255, 255, .06);
  --hero: #1B1F26;
  --hero-grad: linear-gradient(165deg, #1E232B 0%, #1A1E25 62%, #191D23 100%);
  --hero-line: rgba(255, 255, 255, .08);
  --line: rgba(255, 255, 255, .06);
  --line-soft: rgba(255, 255, 255, .04);

  /* ---- 文字（任何文字不暗于 text-3） ---- */
  --text: #F2F3F5;
  --text-2: #A8ADB5;
  --text-3: #8A8F98;

  /* ---- 语义色 ---- */
  --blue: #4C8DFF;
  --blue-weak: rgba(76, 141, 255, .15);
  --blue-40: rgba(76, 141, 255, .40);
  --blue-active: #3B7BEA;
  --expense: #FF6B6B;
  --income: #34D399;
  --ai: #A78BFA;
  --ai-weak: rgba(167, 139, 250, .12);
  --warn: #F5B544;
  --warn-weak: rgba(245, 181, 68, .12);

  /* ---- 中性表面 / 基色（不在页面里再写死） ---- */
  --white: #FFFFFF;
  --btn-off: #262A31;
  --scrim: #000000;
  --panel: #121418;
  --panel-2: #191C21;
  --raised: #23272F;

  /* ---- 分类色板（8 色低饱和，避开红 / 绿 / 蓝 / 紫） ---- */
  --c1: #F5B544;
  --c2: #5CC8D7;
  --c3: #F08AB8;
  --c4: #F59A62;
  --c5: #C8D66B;
  --c6: #8FA3BF;
  --c7: #C49A6C;
  --c8: #9AA0A9;

  /* ---- 字号 ---- */
  --t-h1: 44rpx;
  --t-nav: 36rpx;
  --t-h2: 32rpx;
  --t-body: 30rpx;
  --t-aux: 26rpx;
  --t-min: 24rpx;
  --t-cal: 22rpx;

  /* ---- 间距 ---- */
  --s1: 8rpx;
  --s2: 16rpx;
  --s3: 24rpx;
  --s4: 32rpx;
  --s5: 48rpx;
  --s6: 64rpx;

  /* ---- 圆角 ---- */
  --r-card: 32rpx;
  --r-btn: 28rpx;
  --r-sm: 24rpx;
  --r-pill: 999rpx;

  /* ---- 阴影（仅主按钮允许一档） ---- */
  --shadow-main: 0 8rpx 24rpx rgba(76, 141, 255, .25);

  /* ---- 布局常量 ---- */
  --tab-h: 112rpx;
  --page-x: 32rpx;
  --safe-b: env(safe-area-inset-bottom);
  /* 底部弹层定位：默认贴屏底；tab 页会把它抬到 tab 栏之上（自定义 tab 栏始终盖在页面上层） */
  --sheet-bottom: 0px;
  --sheet-safe: env(safe-area-inset-bottom);

  /* ---- 字体（单一无衬线，禁用毛笔 / 手写 / 衬线） ---- */
  --font-sans: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;

  background-color: var(--bg);
  color: var(--text);
  font-size: var(--t-body);
  line-height: 1.5;
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
}

/* ---- 旧变量兼容（未改版的页面继续可用，值已对齐新规范） ---- */
page {
  --color-brand: var(--blue);
  --color-brand-text: var(--blue);
  --color-brand-strong: var(--blue);
  --color-brand-active: #3B7BEA;
  --color-brand-light: var(--blue-weak);
  --color-expense: var(--expense);
  --color-expense-strong: #FF8B8B;
  --color-income: var(--income);
  --color-income-text: var(--income);
  --color-accent-yellow: var(--warn);
  --color-accent-pink: #F08AB8;
  --color-accent-mint: var(--income);
  --color-warning: var(--warn);
  --color-warning-strong: var(--warn);
  --color-info: var(--blue);
  --color-info-strong: var(--blue);
  --color-text: var(--text);
  --color-text-sub: var(--text-2);
  --color-text-hint: var(--text-3);
  --color-text-placeholder: var(--text-3);
  --color-border: var(--line);
  --color-bg-muted: #1B1F26;
  --color-bg-page: var(--bg);
  --color-bg-card: var(--card);
  --color-mask: rgba(0, 0, 0, .6);

  --screen: var(--bg);
  --card-2: #1B1F26;
  --line-strong: var(--line);
  --muted: var(--text-2);
  --dim: var(--text-3);
  --red: var(--expense);
  --green: var(--income);
  --amber: var(--warn);
  --ai-color: var(--ai);

  --radius-card: var(--r-card);
  --radius-cell: var(--r-sm);
  --radius-input: var(--r-btn);
  --radius-btn: var(--r-btn);
  --radius-pill: var(--r-pill);

  --shadow-card: none;
  --shadow-float: 0 -8rpx 24rpx rgba(0, 0, 0, .5);
  --shadow-btn: var(--shadow-main);

  --gap-page: var(--page-x);
  --gap-xxs: 4rpx;
  --gap-xs: 8rpx;
  --gap-xs2: 12rpx;
  --gap-sm: 16rpx;
  --gap-sm2: 20rpx;
  --gap-md: 24rpx;
  --gap-lg: 32rpx;
  --gap-xl: 48rpx;

  --font-hand: var(--font-sans);
  --font-brush: var(--font-sans);
}

view,
text,
input,
textarea,
button,
scroll-view {
  box-sizing: border-box;
}

input,
textarea,
button {
  font-family: inherit;
}

/* ---- 金额：等宽数字 ---- */
.num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ---- 容器 ---- */
.page {
  min-height: 100vh;
  background-color: var(--bg);
}

.page-pad {
  padding: 0 var(--page-x);
}

/* tab 页内容底部：tab 栏 + 安全区 + 24px */
.page--tab {
  padding-bottom: calc(var(--tab-h) + var(--safe-b) + 48rpx);
  --sheet-bottom: calc(var(--tab-h) + var(--safe-b));
  --sheet-safe: 0px;
}

/* 二级页内容底部：安全区 + 24px */
.page--sub {
  padding-bottom: calc(var(--safe-b) + 48rpx);
}

/* ---- 卡片 ---- */
.card {
  background-color: var(--card);
  border: 2rpx solid var(--card-line);
  border-radius: var(--r-card);
  padding: var(--s4);
  color: var(--text);
}

.card--hero {
  background: var(--hero-grad);
  border-color: var(--hero-line);
}

.card--flush {
  padding: 0;
}

.card + .card {
  margin-top: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---- 文字 ---- */
.text-sub {
  color: var(--text-2);
}

.text-hint {
  color: var(--text-3);
}

.text-title {
  font-size: var(--t-h1);
  font-weight: 600;
  color: var(--text);
}

.section-title {
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--text);
}

.label {
  font-size: var(--t-aux);
  color: var(--text-3);
}

.divider {
  height: 1rpx;
  background-color: var(--line);
}

/* ---- 区块标题行：标题 + 右侧文字按钮 ---- */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 4rpx;
}

.section-head__title {
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--text);
}

.section-head__action {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0 4rpx;
  font-size: 28rpx;
  color: var(--blue);
}

.section-head__action--hover {
  opacity: .7;
}

/* ---- 分段控件 ---- */
.seg {
  display: flex;
  padding: 6rpx;
  border-radius: var(--r-pill);
  background-color: rgba(255, 255, 255, .04);
}

.seg__item {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: var(--t-aux);
  color: var(--text-2);
  border-radius: var(--r-pill);
  transition: background-color .12s ease, color .12s ease;
}

.seg__item.is-on,
.seg__item.is-active {
  background-color: var(--blue-weak);
  color: var(--blue);
  font-weight: 600;
}

/* ---- 胶囊标签 ---- */
.pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: var(--r-pill);
  font-size: var(--t-min);
  color: var(--text-2);
  background-color: rgba(255, 255, 255, .06);
}

.pill--blue {
  color: var(--blue);
  background-color: var(--blue-weak);
}

.pill--income {
  color: var(--income);
  background-color: rgba(52, 211, 153, .15);
}

.pill--warn {
  color: var(--warn);
  background-color: var(--warn-weak);
}

.pill--ai {
  color: var(--ai);
  background-color: var(--ai-weak);
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: var(--r-pill);
  font-size: var(--t-min);
  color: var(--text-2);
  background-color: rgba(255, 255, 255, .06);
}

.tag-ai {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  font-size: var(--t-min);
  color: var(--ai);
  background-color: var(--ai-weak);
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: var(--r-pill);
  font-size: var(--t-min);
  color: var(--blue);
  background-color: var(--blue-weak);
}

/* ---- 图标方块（分类 / 账户统一结构） ---- */
.ico-box {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, .05);
}

/* ---- 按钮 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 var(--s4);
  border: 2rpx solid var(--line);
  border-radius: var(--r-btn);
  font-size: var(--t-body);
  line-height: 1.2;
  background-color: transparent;
  color: var(--text);
  transition: transform .1s ease, opacity .1s ease;
}

.btn::after {
  border: none;
}

.btn--hover,
.btn:active {
  transform: scale(.98);
  opacity: .9;
}

.btn-primary {
  border: none;
  background-color: var(--blue);
  color: var(--white);
  font-weight: 600;
}

.btn-primary.btn--active {
  background-color: var(--blue-active);
}

.btn-primary.btn--disabled {
  background-color: var(--btn-off);
  color: var(--text-3);
}

.btn-ghost {
  background-color: transparent;
  color: var(--text-2);
  border: 2rpx solid rgba(255, 255, 255, .14);
}

.btn-danger-ghost {
  background-color: transparent;
  color: var(--expense);
  border: 2rpx solid rgba(255, 255, 255, .14);
}

.btn--sm {
  min-height: 80rpx;
  border-radius: 24rpx;
  font-size: var(--t-aux);
}

.btn--text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
}

.btn--danger-text {
  color: var(--expense);
}

/* ---- 危险操作 ---- */
.danger-note {
  font-size: var(--t-aux);
  line-height: 1.6;
  color: var(--text-3);
}

.danger-text {
  color: var(--expense);
}

/* ---- 安全区 ---- */
.safe-bottom {
  height: env(safe-area-inset-bottom);
}
