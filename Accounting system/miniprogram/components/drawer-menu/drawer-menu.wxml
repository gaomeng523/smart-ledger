<view class="dm {{mode === 'page' ? 'dm--page' : ''}}">
  <!-- 头部：头像 64px + 昵称 + 两项数据 -->
  <view class="prof">
    <view class="prof__avatar" bindtap="onProfileTap">
      <image wx:if="{{avatarPath}}" class="prof__avatar-img" src="{{avatarPath}}" mode="aspectFill" />
      <text wx:else class="prof__avatar-txt">{{avatarText}}</text>
      <button
        wx:if="{{!guest}}"
        class="prof__avatar-btn"
        open-type="chooseAvatar"
        hover-class="none"
        catchtap="noop"
        bindchooseavatar="onChooseAvatar"
      ></button>
    </view>

    <view class="prof__main" bindtap="onProfileTap">
      <text class="prof__name">{{nickname || (guest ? '未登录' : '微信用户')}}</text>
      <view wx:if="{{guest}}" class="prof__login" hover-class="prof__login--hover" catchtap="onProfileTap">
        <text class="prof__login-txt">登录 / 注册</text>
        <ui-icon name="right" size="24" color="#4C8DFF" />
      </view>
      <text wx:elif="{{!avatarPath}}" class="prof__tip">点头像，选「用微信头像」</text>
    </view>

    <view class="prof__stats">
      <view class="pstat">
        <text class="pstat__n num">{{usedDays}}</text>
        <text class="pstat__k">使用天数</text>
      </view>
      <view class="pstat">
        <text class="pstat__n num">{{billCount}}</text>
        <text class="pstat__k">已记笔数</text>
      </view>
    </view>
  </view>

  <!-- 月度报告（置顶突出） -->
  <view class="report" hover-class="report--hover" bindtap="onReportTap">
    <view class="report__ico">
      <ui-icon name="spark" size="36" color="#A78BFA" />
    </view>
    <view class="report__main">
      <view class="report__title-row">
        <text class="report__title">月度报告</text>
        <text class="report__new">NEW</text>
      </view>
      <text class="report__sub">查看 {{monthNum}} 月消费总结</text>
    </view>
    <ui-icon name="right" size="32" color="#A78BFA" />
  </view>

  <!-- 菜单分组 -->
  <view wx:for="{{groups}}" wx:key="key" class="group">
    <view class="group__title">{{item.title}}</view>
    <view class="card group__card">
      <view
        wx:for="{{item.items}}"
        wx:for-item="row"
        wx:key="key"
        class="mrow"
        hover-class="mrow--hover"
        data-url="{{row.url}}"
        data-tab="{{row.tab}}"
        data-action="{{row.action}}"
        bindtap="onMenuTap"
      >
        <ui-icon name="{{row.icon}}" size="40" color="#A8ADB5" />
        <text class="mrow__label">{{row.label}}</text>
        <text wx:if="{{row.value}}" class="mrow__value">{{row.value}}</text>
        <ui-icon name="right" size="28" color="#8A8F98" />
      </view>
    </view>
  </view>

  <view class="dm__foot">萌萌记账 v{{version}}</view>
</view>
