.bf {
  width: 100%;
}

.bf__mascot {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.bf__mascot-text {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-sub);
}

/* 标签在上、控件通栏在下：所有行左边缘对齐 */
.bf__row {
  display: block;
  margin-bottom: 24rpx;
}

.bf__label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-sub);
}

.bf__field {
  width: 100%;
  min-width: 0;
}

/* 标签行：胶囊自带底色，不额外套字段框 */
.bf__field--chips {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

/* 备注：与其他字段保持同样的浅底框 */
.bf__field--remark {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background-color: var(--color-bg-muted);
  border: 1px solid var(--color-border);
}

.bf__field--amount {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background-color: var(--color-bg-muted);
  border: 1px solid var(--color-border);
}

.bf__field--plain {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background-color: var(--color-bg-muted);
  border: 1px solid var(--color-border);
}

.bf__field--picker {
  display: flex;
  align-items: center;
}

.bf__field.is-invalid {
  border-color: var(--color-warning-strong);
}

.bf__prefix {
  flex: none;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-right: 12rpx;
}

.bf__input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 30rpx;
  color: var(--color-text);
}

.bf__input--num {
  font-size: 40rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.bf__ph {
  color: var(--color-text-placeholder);
  font-size: 30rpx;
  font-weight: 400;
}

.bf__warn {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-warning-strong);
}

/* 分段控件：支出 / 收入 */
.bf__segment {
  display: flex;
  align-items: center;
  background-color: var(--color-bg-muted);
  border-radius: 999rpx;
  padding: var(--gap-xxs);
  width: 100%;
}

.bf__segment-item {
  flex: 1;
  /* §2.4 最小热区 88rpx */
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--color-text-sub);
}

.bf__segment-item.is-active {
  background-color: var(--color-brand-strong);
  color: #FFFFFF;
  font-weight: 600;
}

.bf__picker {
  width: 100%;
}

.bf__picker-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bf__picker-text {
  font-size: 30rpx;
  color: var(--color-text);
}

.bf__arrow {
  margin-left: 16rpx;
  font-size: 32rpx;
  line-height: 1;
  color: var(--color-text-hint);
}
