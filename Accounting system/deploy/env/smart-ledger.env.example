# ============================================================
# /etc/smart-ledger/env   （chmod 600，属主 root）
#
# 对应 application-prod.yml 的占位符，缺一项启动即失败或跑不起来。
# 生成随机 JWT 密钥：openssl rand -base64 48
# ============================================================

# ---- 安全 ----
JWT_SECRET=
# ---- 微信小程序 ----
WX_APP_ID=
WX_APP_SECRET=
# ---- AI ----
DEEPSEEK_API_KEY=
# 文本解析开关（个人主体生产环境默认 false，走本地规则）
AI_ENABLED=false
# 拍照识别（阿里云百炼通义千问视觉模型）
DASHSCOPE_API_KEY=
VISION_ENABLED=true
# 检索增强：解析前召回相似历史记账作为 few-shot（需 DASHSCOPE_API_KEY）
AI_RAG_ENABLED=false
# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_ledger
DB_USERNAME=smart_ledger
DB_PASSWORD=
# ---- 上传目录 ----
UPLOAD_DIR=/opt/smart-ledger/uploads
