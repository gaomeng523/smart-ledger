<view class="page page--sub">
  <nav-bar back title="订阅管理" />

  <view class="body">
    <skeleton wx:if="{{loading}}" rows="3" />

    <block wx:else>
      <!-- 待确认候选 -->
      <view wx:if="{{candidates.length > 0}}" class="section">
        <view class="section-head">
          <text class="section-head__title">待确认</text>
          <text class="section__hint">根据近 6 个月账单识别</text>
        </view>

        <view wx:for="{{candidates}}" wx:key="index" class="card cand">
          <view class="cand__top">
            <view class="cand__ico" style="background-color:{{item.catBg}};">
              <category-icon icon="{{item.icon}}" size="40" color="{{item.catColor}}" />
            </view>
            <view class="cand__main">
              <text class="cand__title">{{item.title}}</text>
              <text class="cand__meta">{{item.cycleText}} · 近 6 月出现 {{item.occurrences}} 次</text>
            </view>
            <text class="cand__amt num">¥{{item.amountText}}</text>
          </view>
          <view class="cand__ops">
            <view class="ops__btn ops__btn--primary" data-index="{{item.index}}" catchtap="onConfirmCandidate">确认</view>
            <view class="ops__btn" data-index="{{item.index}}" catchtap="onSkipCandidate">忽略</view>
          </view>
        </view>
      </view>

      <!-- 我的订阅 -->
      <view wx:if="{{candidates.length > 0 || items.length > 0}}" class="section">
        <view class="section-head">
          <text class="section-head__title">我的订阅</text>
          <view class="section-head__action" hover-class="section-head__action--hover" bindtap="openNew">+ 添加</view>
        </view>

        <view wx:if="{{items.length === 0}}" class="sub-empty">暂无订阅，点右上「+ 添加」</view>

        <view wx:if="{{items.length > 0}}" class="card sub-card">
          <view
            wx:for="{{items}}"
            wx:key="id"
            class="row"
            hover-class="row--hover"
            data-id="{{item.id}}"
            bindtap="openEdit"
          >
            <view class="row__ico" style="background-color:{{item.catBg}};">
              <category-icon icon="{{item.icon}}" size="40" color="{{item.catColor}}" />
            </view>
            <view class="row__main">
              <view class="row__title-line">
                <text class="row__title">{{item.title}}</text>
                <text wx:if="{{item.paused}}" class="pill">已暂停</text>
              </view>
              <text class="row__meta">{{item.cycleText}} · {{item.dueText}}</text>
            </view>
            <view class="row__right">
              <text class="row__amt num {{item.paused ? 'is-paused' : ''}}">¥{{item.amountText}}</text>
              <text class="row__cycle">{{item.cycleShort}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态：既无候选也无订阅 -->
      <empty-state
        wx:if="{{candidates.length === 0 && items.length === 0}}"
        mascotState="empty"
        text="还没有订阅，点击下方按钮添加"
        actionText="添加订阅"
        bind:action="openNew"
      />
    </block>
  </view>
</view>

<!-- ===== 新建 / 确认 / 编辑弹层 ===== -->
<view wx:if="{{sheetVisible}}" class="mask" bindtap="closeSheet" catchtouchmove="noop"></view>
<view wx:if="{{sheetVisible}}" class="panel">
  <view class="panel__header">
    <text class="panel__title">{{sheetMode === 'edit' ? '编辑订阅' : (sheetMode === 'confirm' ? '确认订阅' : '添加订阅')}}</text>
    <view class="panel__close" bindtap="closeSheet">关闭</view>
  </view>

  <scroll-view class="panel__body" scroll-y>
    <view class="panel__row">
      <text class="panel__label">名称</text>
      <view class="panel__field">
        <input
          class="panel__text"
          placeholder="如：视频会员"
          placeholder-class="panel__ph"
          maxlength="20"
          value="{{form.title}}"
          bindinput="onTitleInput"
        />
      </view>
    </view>

    <view class="panel__row">
      <text class="panel__label">参考金额</text>
      <view class="panel__amount">
        <text class="panel__prefix">¥</text>
        <input
          class="panel__input"
          type="digit"
          placeholder="0.00"
          placeholder-class="panel__ph"
          value="{{form.avgAmount}}"
          bindinput="onAmountInput"
        />
      </view>
    </view>

    <view class="panel__row">
      <text class="panel__label">周期</text>
      <view class="seg">
        <view
          wx:for="{{cycles}}"
          wx:key="value"
          class="seg__item {{form.cycleDays === item.value ? 'is-on' : ''}}"
          data-value="{{item.value}}"
          bindtap="onCycleSelect"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="panel__row">
      <text class="panel__label">下次扣费</text>
      <view class="panel__field">
        <picker class="panel__picker-wrap" mode="date" value="{{form.nextDate}}" bindchange="onNextDateChange">
          <view class="panel__picker">
            <text class="panel__text {{form.nextDate ? '' : 'panel__ph'}}">{{form.nextDate || '请选择日期'}}</text>
            <ui-icon name="right" size="32" color="#8A8F98" />
          </view>
        </picker>
      </view>
    </view>

    <block wx:if="{{sheetMode === 'new'}}">
      <view class="panel__row">
        <text class="panel__label">分类</text>
        <view class="panel__field panel__field--picker">
          <dict-picker
            type="category"
            billType="{{0}}"
            value="{{form.categoryCode}}"
            dict="{{dict}}"
            placeholder="请选择分类"
            bind:change="onCategoryChange"
          />
        </view>
      </view>
      <view class="panel__row">
        <text class="panel__label">支付渠道</text>
        <view class="panel__field panel__field--picker">
          <dict-picker
            type="channel"
            value="{{form.payChannelCode}}"
            dict="{{dict}}"
            placeholder="请选择支付渠道"
            bind:change="onChannelChange"
          />
        </view>
      </view>
    </block>

    <view wx:if="{{sheetMode === 'edit'}}" class="panel__row">
      <text class="panel__label">状态</text>
      <view class="seg">
        <view class="seg__item {{form.status === 1 ? 'is-on' : ''}}" data-value="{{1}}" bindtap="onStatusSelect">正常</view>
        <view class="seg__item {{form.status === 0 ? 'is-on' : ''}}" data-value="{{0}}" bindtap="onStatusSelect">暂停</view>
      </view>
    </view>

    <view wx:if="{{sheetMode === 'edit'}}" class="panel__danger" bindtap="onDeleteFromSheet">
      <ui-icon name="trash" size="36" color="#A8ADB5" />
      <text class="panel__danger-text">删除这个订阅</text>
    </view>
  </scroll-view>

  <view class="panel__footer">
    <view
      class="btn btn-primary panel__save {{saving ? 'btn--disabled' : ''}}"
      hover-class="{{saving ? '' : 'btn--hover'}}"
      bindtap="onSheetSave"
    >{{saving ? '保存中…' : '保存'}}</view>
  </view>
</view>
