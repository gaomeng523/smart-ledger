/* 模板条目：左滑露出编辑 / 删除 */
.tpl {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-card);
}

.tpl__actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
}

.tpl__action {
  width: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--t-aux);
}

.tpl__action--edit {
  background-color: var(--raised, #23272F);
  color: var(--text);
}

.tpl__action--del {
  background-color: var(--raised, #23272F);
  color: var(--expense);
}

.tpl__card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: var(--r-card);
  background-color: var(--card);
  border: 2rpx solid var(--card-line);
  transition: transform .18s ease;
}

.tpl__ico {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}

.tpl__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.tpl__title {
  font-size: var(--t-h2);
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tpl__meta {
  margin-top: 6rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tpl__right {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.tpl__amount {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.tpl__amount.is-income {
  color: var(--income);
}

.tpl__use {
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  background-color: var(--blue-weak);
  font-size: var(--t-min);
  color: var(--blue);
}
