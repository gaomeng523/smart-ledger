/**
 * 统计 · 月度报告（设计稿 03 屏）
 */
.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: radial-gradient(120% 55% at 50% 0%, #131417 0%, #0B0B0C 44%, #08090A 100%);
}

.body {
  padding: 8rpx 32rpx 0;
}

.mhead {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.mhead__m {
  font-family: var(--font-brush);
  font-size: 44rpx;
  color: #F0F0EE;
  letter-spacing: .06em;
}

.mhead__y {
  font-size: 20rpx;
  color: #62636A;
  letter-spacing: .1em;
}

.macts {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mact {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.mact--hover {
  background-color: rgba(255, 255, 255, .06);
}

/* ---- 标题 ---- */

.hero {
  padding: 18rpx 4rpx 26rpx;
}

.hero__eyebrow {
  font-family: var(--font-sans);
  font-size: 17rpx;
  letter-spacing: .28em;
  color: #5E5F66;
}

.hero__row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 12rpx;
}

.hero__title {
  font-family: var(--font-brush);
  font-size: 62rpx;
  line-height: 1.15;
  color: #F2F2EF;
  letter-spacing: .04em;
}

.hero__delta {
  font-family: var(--font-sans);
  font-size: 19rpx;
  color: #57D9A3;
  background-color: rgba(87, 217, 163, .12);
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  letter-spacing: .04em;
}

.hero__delta.is-up {
  color: #FF9B9B;
  background-color: rgba(255, 107, 107, .12);
}

.hero__sub {
  display: block;
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #62636A;
  letter-spacing: .04em;
}

/* ---- KPI ---- */

.kpis {
  display: flex;
  padding: 26rpx 8rpx 30rpx;
  background-color: #131417;
  border: 1rpx solid rgba(255, 255, 255, .04);
  border-radius: 36rpx;
}

.kpi {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
}

.kpi + .kpi::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 1rpx;
  background-color: rgba(255, 255, 255, .06);
}

.kpi__k {
  font-size: 19rpx;
  color: #62636A;
  letter-spacing: .16em;
}

.kpi__v {
  font-family: var(--font-sans);
  font-size: 30rpx;
  color: #E8E8E4;
  letter-spacing: -.01em;
}

.kpi__v.is-out {
  color: #FF8B8B;
}

.kpi__v.is-in {
  color: #79E0B4;
}

/* ---- 卡片通用 ---- */

.card {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  border-radius: 40rpx;
  background: linear-gradient(165deg, #191A1D, #141518 70%);
  border: 1rpx solid rgba(255, 255, 255, .055);
}

.card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.card__title {
  font-size: 27rpx;
  color: #E0E1DD;
  letter-spacing: .1em;
}

.card__aside {
  font-size: 20rpx;
  color: #62636A;
  letter-spacing: .04em;
}

/* ---- 柱图 ---- */

.bars {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 184rpx;
  padding-top: 12rpx;
}

.bar {
  flex: 1;
  border-radius: 6rpx 6rpx 3rpx 3rpx;
  background: linear-gradient(180deg, #3F4046, #2A2B30);
  min-height: 3rpx;
}

.bar.is-empty {
  background-color: #232428;
}

.bar.is-today {
  background: linear-gradient(180deg, #6FA6FF, #2F6FE6);
  box-shadow: 0 0 20rpx rgba(61, 139, 255, .5);
}

.scale {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-family: var(--font-sans);
  font-size: 17rpx;
  color: #46474E;
}

/* ---- 分类构成 ---- */

.cat__seg {
  display: flex;
  gap: 6rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background-color: #0E0F11;
}

.cat__seg-item {
  font-size: 19rpx;
  color: #62636A;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  letter-spacing: .04em;
}

.cat__seg-item.is-on {
  color: #DDE6FF;
  background-color: #1E2A42;
}

.cat__body {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.cat__chart {
  width: 280rpx;
  flex: none;
}

.cat__legend {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.lg {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 46rpx;
  padding: 0 8rpx;
  border-radius: 12rpx;
}

.lg--hover {
  background-color: rgba(255, 255, 255, .04);
}

.lg__dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
}

.lg__name {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  color: #C9CAC6;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lg__ratio {
  font-family: var(--font-sans);
  font-size: 18rpx;
  color: #62636A;
  width: 64rpx;
  text-align: right;
}

.lg__amt {
  font-size: 21rpx;
  color: #9A9BA1;
  width: 112rpx;
  text-align: right;
}

.cat__empty {
  font-size: 20rpx;
  color: #4E4F56;
  padding: 20rpx 0;
}

.cat__back {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 8rpx 20rpx 8rpx 12rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, .04);
  font-size: 19rpx;
  color: #8A8B92;
}

/* ---- AI 洞察 ---- */

.ai {
  margin-top: 22rpx;
  padding: 26rpx 28rpx 20rpx;
  border-radius: 40rpx;
  background-color: rgba(139, 108, 255, .055);
  border: 1rpx solid rgba(139, 108, 255, .13);
}

.ai__head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.ai__ico {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(139, 108, 255, .16);
}

.ai__title {
  font-size: 25rpx;
  color: #C9B8FF;
  letter-spacing: .1em;
}

.ai__sub {
  margin-left: auto;
  font-size: 18rpx;
  color: #5E5F66;
}

.ai__item {
  display: flex;
  gap: 12rpx;
  padding: 10rpx 0;
}

.ai__bullet {
  width: 8rpx;
  height: 8rpx;
  flex: none;
  margin-top: 14rpx;
  border-radius: 50%;
  background-color: #8B6CFF;
}

.ai__text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.6;
  color: #A9A0C8;
  letter-spacing: .02em;
}

.ai__empty {
  font-size: 21rpx;
  color: #5E5F66;
  padding: 8rpx 0 12rpx;
}

.foot {
  padding: 30rpx 0 10rpx;
  text-align: center;
  font-size: 18rpx;
  color: #46474E;
  letter-spacing: .06em;
}
