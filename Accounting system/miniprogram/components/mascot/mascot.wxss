/* 空状态吉祥物：低饱和线稿云朵，96–120px，无发光 */
.mascot {
  position: relative;
  flex: none;
}

.mascot__cloud {
  position: absolute;
  inset: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%20120%20104'%20fill%3D'none'%3E%3Cpath%20d%3D'M36%2082h48c12.7%200%2023-9.4%2023-21%200-9.9-7.5-18.2-17.6-20.2C87.6%2030.4%2078.6%2023%2068%2023c-7.6%200-14.3%203.6-18.2%209.2A21.6%2021.6%200%200045%2031c-11.2%200-20.4%208.3-21.4%2019C15.6%2052.6%2010%2059.8%2010%2068.2%2010%2075.7%2016%2082%2024%2082h12z'%20stroke%3D'%23A8ADB5'%20stroke-opacity%3D'.42'%20stroke-width%3D'2.4'%20fill%3D'%23FFFFFF'%20fill-opacity%3D'.03'%20stroke-linejoin%3D'round'%2F%3E%3C%2Fsvg%3E");
}

.mascot__face {
  position: absolute;
  left: 8%;
  right: 8%;
  top: 22%;
  bottom: 12%;
}

.mascot__eye {
  position: absolute;
  top: 52%;
  width: 8.5%;
  aspect-ratio: 1;
  border-radius: 50%;
  background-color: rgba(168, 173, 181, .78);
}

.mascot__eye--l { left: 38%; }
.mascot__eye--r { left: 56.5%; }

.mascot__cheek {
  position: absolute;
  top: 62%;
  width: 12%;
  height: 6%;
  border-radius: 50%;
  background-color: rgba(240, 138, 184, .16);
}

.mascot__cheek--l { left: 28%; }
.mascot__cheek--r { left: 60%; }

.mascot__mouth {
  position: absolute;
  top: 62%;
  left: 45%;
  width: 10%;
  height: 5%;
  border-bottom: 2rpx solid rgba(168, 173, 181, .7);
  border-radius: 0 0 999rpx 999rpx;
}

/* 离线：闭眼 */
.mascot--offline .mascot__eye {
  height: 2rpx;
  border-radius: 2rpx;
  background-color: rgba(168, 173, 181, .6);
}

.mascot--offline .mascot__mouth {
  width: 6%;
  left: 47%;
  top: 64%;
  height: 0;
  border-bottom-width: 2rpx;
}

/* 思考：右上方三个小点 */
.mascot__dots {
  position: absolute;
  right: 6%;
  top: 6%;
  display: flex;
  gap: 6rpx;
}

.mascot__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: rgba(167, 139, 250, .55);
}
