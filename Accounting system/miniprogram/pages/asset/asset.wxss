/* 我的账户：净资产为主角 + 账户列表 + AI 体检卡 */
.body {
  padding: 32rpx var(--page-x) 0;
}

/* ---------- 净资产 ---------- */
.net {
  padding: 32rpx;
}

.net__k {
  font-size: var(--t-aux);
  color: var(--text-2);
}

.net__row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.net__cur {
  margin-right: 8rpx;
  font-size: 32rpx;
  color: var(--text-2);
}

.net__v {
  font-size: 80rpx;
  font-weight: 600;
  line-height: 1.05;
  color: var(--text);
}

.net__v.is-negative {
  color: var(--expense);
}

.net__dec {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--text-2);
}

.net__sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
}

.net__debt {
  color: var(--text-3);
}

.net__debt.is-danger {
  color: var(--expense);
}

/* ---------- 账户 ---------- */
.accounts {
  margin-top: 24rpx;
  padding: 24rpx;
}

.card__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 8rpx;
}

.card__title {
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--text);
}

.card__aside {
  font-size: var(--t-min);
  color: var(--text-3);
}

.acc {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  border-bottom: 2rpx solid var(--line-soft);
}

.acc--hover {
  background-color: rgba(255, 255, 255, .03);
}

.acc__ico {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, .05);
}

.acc__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: flex-start;
}

.acc__name {
  font-size: 32rpx;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

.acc__kind {
  height: 36rpx;
  padding: 0 12rpx;
  display: inline-flex;
  align-items: center;
  border-radius: var(--r-pill);
  font-size: var(--t-min);
  color: var(--text-2);
  background-color: rgba(255, 255, 255, .05);
}

.acc__amt {
  flex: none;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.acc__amt.is-debt {
  color: var(--expense);
}

.acc-add {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 104rpx;
}

.acc-add--hover {
  opacity: .7;
}

.acc-add__text {
  font-size: 30rpx;
  color: var(--blue);
}

/* ---------- 体检 ---------- */
.check {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: var(--r-card);
  background-color: var(--ai-weak);
  border: 2rpx solid rgba(167, 139, 250, .16);
}

.check__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.check__title {
  flex: 1;
  font-size: var(--t-h2);
  font-weight: 600;
  color: var(--text);
}

.check__score {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1;
}

.check__unit {
  margin-left: 4rpx;
  font-size: var(--t-min);
  font-weight: 400;
}

.check__bar {
  height: 12rpx;
  margin-top: 24rpx;
  border-radius: var(--r-pill);
  background-color: rgba(255, 255, 255, .08);
  overflow: hidden;
}

.check__bar-fill {
  height: 100%;
  border-radius: var(--r-pill);
}

.check__state {
  display: block;
  margin-top: 12rpx;
  font-size: var(--t-aux);
}

.check__item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
}

.check__dot {
  width: 8rpx;
  height: 8rpx;
  flex: none;
  margin-top: 14rpx;
  border-radius: 50%;
  background-color: var(--ai);
}

.check__text {
  flex: 1;
  font-size: var(--t-aux);
  line-height: 1.6;
  color: var(--text-2);
}

.check__empty {
  display: block;
  margin-top: 16rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
}

.tip {
  padding: 48rpx 8rpx 0;
  font-size: var(--t-min);
  line-height: 1.7;
  color: var(--text-3);
}
