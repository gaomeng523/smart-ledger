<view class="page page--sub">
  <nav-bar back title="我的账户" />

  <view class="body">
    <!-- 净资产（主角卡片） -->
    <view class="card card--hero net">
      <text class="net__k">净资产</text>
      <view class="net__row">
        <text class="net__cur">{{netNegative ? '-¥' : '¥'}}</text>
        <text class="net__v num {{netNegative ? 'is-negative' : ''}}">{{netInt}}<text class="net__dec">.{{netDec}}</text></text>
      </view>
      <view class="net__sub">
        <text>{{accountCount}} 个账户 · 手动维护</text>
        <text class="net__debt {{debtDanger ? 'is-danger' : ''}}">待还 ¥{{debtText}}</text>
      </view>
    </view>

    <!-- 账户余额 -->
    <view class="card accounts">
      <view class="card__head">
        <text class="card__title">账户余额</text>
        <text class="card__aside">点击修改 · 长按删除</text>
      </view>

      <view
        wx:for="{{accounts}}"
        wx:key="id"
        class="acc"
        hover-class="acc--hover"
        data-id="{{item.id}}"
        bindtap="onAccountTap"
        bindlongpress="onAccountLongPress"
      >
        <view class="acc__ico">
          <ui-icon name="{{item.icon}}" size="36" color="#A8ADB5" />
        </view>
        <view class="acc__main">
          <text class="acc__name">{{item.name}}</text>
          <text class="acc__kind">{{item.isDebt ? '负债' : '资产'}}</text>
        </view>
        <text class="acc__amt num {{item.showDebt ? 'is-debt' : ''}}">{{item.amountText}}</text>
      </view>

      <view class="acc-add" hover-class="acc-add--hover" bindtap="onAddAccount">
        <ui-icon name="plus" size="32" color="#4C8DFF" />
        <text class="acc-add__text">新增账户</text>
      </view>
    </view>

    <!-- 资产体检（AI 紫，星标仅此处） -->
    <view class="check">
      <view class="check__head">
        <ui-icon name="spark" size="30" color="#A78BFA" />
        <text class="check__title">资产体检</text>
        <view wx:if="{{hasData}}" class="check__score num" style="color:{{scoreColor}};">
          {{score}}<text class="check__unit">分</text>
        </view>
      </view>

      <block wx:if="{{hasData}}">
        <view class="check__bar">
          <view class="check__bar-fill" style="width:{{score}}%;background-color:{{scoreColor}};"></view>
        </view>
        <text class="check__state" style="color:{{scoreColor}};">{{scoreText}}</text>
        <view wx:for="{{findings}}" wx:key="key" class="check__item">
          <view class="check__dot"></view>
          <text class="check__text">{{item.text}}</text>
        </view>
      </block>

      <text wx:else class="check__empty">录入账户余额后，生成资产体检</text>
    </view>

    <view class="tip">账户余额只保存在本机，不会上传；记账流水仍以服务器为准。</view>
  </view>
</view>
