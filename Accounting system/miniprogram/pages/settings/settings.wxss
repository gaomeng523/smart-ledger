/* 设置页：三组设置 + 危险操作组 + 底部退出 */
.body {
  /* 导航下 32rpx；底部安全区 + 32px，保证标语不被 Home 指示条压住 */
  padding: 32rpx var(--page-x) calc(env(safe-area-inset-bottom) + 64rpx);
}

/* 底部留白由 .body 接管，避免与 page--sub 的安全区叠加 */
.settings {
  padding-bottom: 0;
}

.group {
  margin-bottom: 24rpx;
}

.group__title {
  padding: 8rpx 8rpx 12rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
}

.group__card {
  padding: 0 24rpx;
}

.crow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  border-bottom: 2rpx solid var(--line-soft);
}

.crow:last-child {
  border-bottom: none;
}

.crow--hover {
  background-color: rgba(255, 255, 255, .03);
}

.crow__label {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  color: var(--text);
}

.crow__label.is-danger {
  color: var(--expense);
}

.crow__value {
  font-size: 30rpx;
  color: var(--text-2);
}

.crow__note {
  padding: 16rpx 0 24rpx;
  font-size: var(--t-aux);
  line-height: 1.6;
  color: var(--text-3);
}

.logout {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  margin-top: 40rpx;
  border-radius: var(--r-btn);
  border: 2rpx solid rgba(255, 255, 255, .14);
  background-color: transparent;
}

.logout--hover {
  transform: scale(.98);
  background-color: rgba(255, 255, 255, .04);
}

.logout__txt {
  font-size: 32rpx;
  color: var(--expense);
}

.foot {
  padding: 48rpx 0 0;
  text-align: center;
  font-size: var(--t-aux);
  color: var(--text-3);
}
