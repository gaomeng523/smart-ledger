<view class="mascot mascot--{{state}}" style="width:{{size}}rpx;height:{{size}}rpx;">
  <view class="mascot__cloud"></view>

  <view class="mascot__face">
    <view class="mascot__eye mascot__eye--l"></view>
    <view class="mascot__eye mascot__eye--r"></view>
    <view class="mascot__cheek mascot__cheek--l"></view>
    <view class="mascot__cheek mascot__cheek--r"></view>
    <view class="mascot__mouth"></view>
  </view>

  <view wx:if="{{state === 'thinking'}}" class="mascot__dots">
    <view class="mascot__dot"></view>
    <view class="mascot__dot"></view>
    <view class="mascot__dot"></view>
  </view>
</view>
