/* 订阅管理：待确认 + 我的订阅（行式列表） */
.body {
  padding: 32rpx var(--page-x) 0;
}

.section {
  margin-bottom: 24rpx;
}

.section__hint {
  font-size: var(--t-min);
  color: var(--text-3);
}

.sub-empty {
  padding: 24rpx 8rpx;
  font-size: var(--t-aux);
  color: var(--text-3);
}

/* ---------- 待确认 ---------- */
.cand {
  margin-top: 16rpx;
  padding: 24rpx;
}

.cand__top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cand__ico {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}

.cand__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.cand__title {
  font-size: 32rpx;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cand__meta {
  margin-top: 6rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cand__amt {
  flex: none;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.cand__ops {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.ops__btn {
  flex: 1;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, .14);
  font-size: var(--t-aux);
  color: var(--text-2);
}

.ops__btn--primary {
  border: none;
  background-color: var(--blue);
  color: var(--white);
  font-weight: 600;
}

/* ---------- 我的订阅 ---------- */
.sub-card {
  padding: 0 24rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  border-bottom: 2rpx solid var(--line-soft);
}

.row:last-child {
  border-bottom: none;
}

.row--hover {
  background-color: rgba(255, 255, 255, .03);
}

.row__ico {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.row__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.row__title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.row__title {
  font-size: 32rpx;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row__meta {
  margin-top: 6rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row__right {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.row__amt {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.row__amt.is-paused {
  color: var(--text-3);
}

.row__cycle {
  margin-top: 4rpx;
  font-size: var(--t-min);
  color: var(--text-3);
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background-color: rgba(0, 0, 0, .6);
}

.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 81;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  background-color: var(--card);
  border-radius: var(--r-card) var(--r-card) 0 0;
  border-top: 2rpx solid var(--card-line);
}

.panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid var(--line);
}

.panel__title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}

.panel__close {
  min-width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: var(--text-3);
}

.panel__body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 32rpx;
}

.panel__row {
  margin-bottom: 24rpx;
}

.panel__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
}

.panel__field,
.panel__amount {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background-color: var(--card-2);
  border: none;
}

.panel__amount {
  gap: 8rpx;
}

/* dict-picker 自带 104rpx 容器：外层只做包裹，避免内外双层边框 */
.panel__field--picker {
  height: auto;
  padding: 0;
  background-color: transparent;
  border: none;
}

.panel__text,
.panel__input {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: var(--text);
}

.panel__text {
  display: flex;
  align-items: center;
  height: 104rpx;
}

.panel__input {
  height: 104rpx;
}

.panel__prefix {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--text-2);
}

.panel__ph {
  color: var(--text-3);
}

.panel__picker-wrap {
  flex: 1;
  min-width: 0;
}

.panel__picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  height: 104rpx;
}

.panel__danger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 96rpx;
  margin-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.panel__danger-text {
  font-size: var(--t-aux);
  color: var(--expense);
}

.panel__footer {
  display: flex;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--line);
}

.panel__save {
  flex: 1;
  height: 96rpx;
  min-height: 96rpx;
  border-radius: 24rpx;
  background-color: var(--blue);
  color: var(--white);
  font-size: 32rpx;
  font-weight: 600;
}

/* 分段控件复用全局 .seg，未选中项用更弱的文字色 */
.panel__row .seg__item {
  color: var(--text-3);
}

.panel__row .seg__item.is-on {
  color: var(--blue);
}
