/* 心愿储蓄：汇总（主角卡片）+ 心愿卡 + 弹层 */
.body {
  padding: 32rpx var(--page-x) 0;
}

/* ---------- 汇总 ---------- */
.summary {
  display: flex;
  padding: 32rpx 16rpx;
}

.sum {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sum__n {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--text);
}

.sum__k {
  margin-top: 8rpx;
  font-size: var(--t-min);
  color: var(--text-2);
}

/* ---------- 心愿卡 ---------- */
.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.goal {
  padding: 24rpx;
}

.goal__top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.goal__ico {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, .05);
}

.goal__title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goal__pill {
  flex: none;
  height: 44rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  border-radius: var(--r-pill);
  font-size: var(--t-min);
  color: var(--blue);
  background-color: var(--blue-weak);
}

.goal__pill.is-done {
  color: var(--income);
  background-color: rgba(52, 211, 153, .15);
}

.goal__nums {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 24rpx;
}

.goal__amounts {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.goal__saved {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.goal__target {
  font-size: var(--t-aux);
  color: var(--text-2);
}

.goal__pct {
  flex: none;
  font-size: var(--t-aux);
  color: var(--text-2);
}

.bar {
  height: 16rpx;
  margin-top: 12rpx;
  border-radius: var(--r-pill);
  background-color: rgba(255, 255, 255, .10);
  overflow: hidden;
}

.bar__fill {
  height: 100%;
  border-radius: var(--r-pill);
  background-color: var(--blue);
}

.goal__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
}

.goal__ops {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 20rpx;
}

.op {
  min-height: 80rpx;
  border-radius: 24rpx;
  font-size: var(--t-aux);
}

.op--primary {
  flex: 1;
}

.op-text {
  min-width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--t-aux);
  color: var(--text-2);
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background-color: rgba(0, 0, 0, .6);
}

.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 81;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  background-color: var(--card);
  border-radius: var(--r-card) var(--r-card) 0 0;
  border-top: 2rpx solid var(--card-line);
}

.panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid var(--line);
}

.panel__title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}

.panel__close {
  min-width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: var(--text-3);
}

.panel__body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 32rpx;
}

.panel__row {
  margin-bottom: 24rpx;
}

.panel__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--t-aux);
  color: var(--text-2);
}

.panel__field,
.panel__amount {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background-color: var(--card-2);
  border: none;
}

.panel__amount {
  gap: 8rpx;
}

.panel__text,
.panel__input {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: var(--text);
}

.panel__text {
  display: flex;
  align-items: center;
  height: 104rpx;
}

.panel__input {
  height: 104rpx;
}

.panel__prefix {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--text-2);
}

.panel__ph {
  color: var(--text-3);
}

.panel__picker-wrap {
  flex: 1;
  min-width: 0;
}

.panel__picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  height: 104rpx;
}

.panel__danger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 96rpx;
  margin-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.panel__danger-text {
  font-size: var(--t-aux);
  color: var(--expense);
}

.icons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.icons__item {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background-color: var(--card-2);
  border: 2rpx solid transparent;
}

.icons__item.is-active {
  background-color: var(--blue-weak);
  border-color: var(--blue);
}

.panel__amount--lg {
  height: 128rpx;
  margin-top: 8rpx;
}

.panel__prefix--lg {
  font-size: 40rpx;
}

.panel__input--lg {
  height: 128rpx;
  font-size: 64rpx;
  font-weight: 600;
}

.quick {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.quick__item {
  height: 72rpx;
  padding: 0 28rpx;
  display: inline-flex;
  align-items: center;
  border-radius: var(--r-pill);
  background-color: rgba(255, 255, 255, .05);
  font-size: var(--t-aux);
  color: var(--text);
}

.panel__footer {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--line);
}

.panel__save {
  flex: 1;
  height: 96rpx;
  min-height: 96rpx;
  border-radius: 24rpx;
  background-color: var(--blue);
  color: var(--white);
  font-size: 32rpx;
  font-weight: 600;
}
