/* 空状态：插画 96–120px，文案 14px 次要色，主按钮高 44、蓝色实底、无发光 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 96rpx;
}

.empty__text {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
  color: var(--text-2, #A8ADB5);
}

.empty__btn {
  margin-top: 32rpx;
  min-width: 280rpx;
  height: 88rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-btn, 28rpx);
  background-color: var(--blue, #4C8DFF);
  color: var(--white, #FFFFFF);
  font-size: 30rpx;
  font-weight: 600;
  transition: transform .1s ease;
}

.empty__btn--hover {
  transform: scale(.98);
  opacity: .92;
}
