<view class="page page--sub">
  <nav-bar back title="心愿储蓄" />

  <view class="body">
    <skeleton wx:if="{{loading}}" rows="3" />

    <block wx:else>
      <empty-state
        wx:if="{{count === 0}}"
        mascotState="empty"
        text="还没有心愿，新建一个吧"
        actionText="新建心愿"
        bind:action="openNew"
      />

      <block wx:else>
        <!-- 汇总（主角卡片） -->
        <view class="card card--hero summary">
          <view class="sum">
            <text class="sum__n num">¥{{totalSavedText}}</text>
            <text class="sum__k">已存总额</text>
          </view>
          <view class="sum">
            <text class="sum__n num">{{count}}</text>
            <text class="sum__k">心愿数</text>
          </view>
          <view class="sum">
            <text class="sum__n num">{{achieved}}</text>
            <text class="sum__k">已达成</text>
          </view>
        </view>

        <view class="section-head">
          <text class="section-head__title">我的心愿</text>
          <view class="section-head__action" hover-class="section-head__action--hover" bindtap="openNew">+ 新建</view>
        </view>

        <view class="list">
          <view wx:for="{{items}}" wx:key="id" class="goal card">
            <view class="goal__top">
              <view class="goal__ico">
                <ui-icon name="{{item.icon}}" size="44" color="#A8ADB5" />
              </view>
              <text class="goal__title">{{item.title}}</text>
              <text class="goal__pill {{item.done ? 'is-done' : ''}}">{{item.done ? '已达成' : '进行中'}}</text>
            </view>

            <view class="goal__nums">
              <view class="goal__amounts">
                <text class="goal__saved num">¥{{item.savedText}}</text>
                <text class="goal__target num">/ ¥{{item.targetText}}</text>
              </view>
              <text class="goal__pct num">{{item.percent}}%</text>
            </view>

            <view class="bar">
              <view class="bar__fill" style="width:{{item.percent}}%;"></view>
            </view>

            <view class="goal__meta">
              <text>{{item.remainText}}</text>
              <text>{{item.daysText}}</text>
            </view>

            <view class="goal__ops">
              <view
                class="btn btn-primary op op--primary"
                hover-class="btn--hover"
                data-id="{{item.id}}"
                catchtap="openAdd"
              >存一笔</view>
              <text
                wx:if="{{item.canWithdraw}}"
                class="op-text"
                data-id="{{item.id}}"
                catchtap="openTake"
              >取出</text>
              <text
                class="op-text"
                data-id="{{item.id}}"
                catchtap="openEdit"
              >编辑</text>
            </view>
          </view>
        </view>
      </block>
    </block>
  </view>
</view>

<!-- ===== 新建 / 编辑弹层 ===== -->
<view wx:if="{{sheetVisible}}" class="mask" bindtap="closeSheet" catchtouchmove="noop"></view>
<view wx:if="{{sheetVisible}}" class="panel">
  <view class="panel__header">
    <text class="panel__title">{{sheetMode === 'edit' ? '编辑心愿' : '新建心愿'}}</text>
    <view class="panel__close" bindtap="closeSheet">关闭</view>
  </view>

  <scroll-view class="panel__body" scroll-y>
    <view class="panel__row">
      <text class="panel__label">图标</text>
      <view class="icons">
        <view
          wx:for="{{icons}}"
          wx:key="icon"
          class="icons__item {{selectedIcon === item.emoji ? 'is-active' : ''}}"
          data-icon="{{item.emoji}}"
          bindtap="onIconSelect"
        >
          <ui-icon name="{{item.icon}}" size="40" color="{{selectedIcon === item.emoji ? '#4C8DFF' : '#A8ADB5'}}" />
        </view>
      </view>
    </view>

    <view class="panel__row">
      <text class="panel__label">名称</text>
      <view class="panel__field">
        <input
          class="panel__text"
          placeholder="如：换台新相机"
          placeholder-class="panel__ph"
          maxlength="20"
          value="{{form.title}}"
          bindinput="onTitleInput"
        />
      </view>
    </view>

    <view class="panel__row">
      <text class="panel__label">目标金额</text>
      <view class="panel__amount">
        <text class="panel__prefix">¥</text>
        <input
          class="panel__input"
          type="digit"
          placeholder="0.00"
          placeholder-class="panel__ph"
          value="{{form.targetAmount}}"
          bindinput="onTargetInput"
        />
      </view>
    </view>

    <view class="panel__row">
      <text class="panel__label">计划日</text>
      <view class="panel__field">
        <picker class="panel__picker-wrap" mode="date" value="{{form.dueDate}}" bindchange="onDueChange">
          <view class="panel__picker">
            <text class="panel__text {{form.dueDate ? '' : 'panel__ph'}}">{{form.dueDate || '选填，选个目标日期'}}</text>
            <ui-icon name="right" size="32" color="#8A8F98" />
          </view>
        </picker>
      </view>
    </view>

    <view wx:if="{{sheetMode === 'edit'}}" class="panel__danger" bindtap="onDeleteFromSheet">
      <ui-icon name="trash" size="36" color="#A8ADB5" />
      <text class="panel__danger-text">删除这个心愿</text>
    </view>
  </scroll-view>

  <view class="panel__footer">
    <view
      class="btn btn-primary panel__save {{saving ? 'btn--disabled' : ''}}"
      hover-class="{{saving ? '' : 'btn--hover'}}"
      bindtap="onSheetSave"
    >{{saving ? '保存中…' : '保存'}}</view>
  </view>
</view>

<!-- ===== 存 / 取金额弹层 ===== -->
<view wx:if="{{amountVisible}}" class="mask" bindtap="closeAmount" catchtouchmove="noop"></view>
<view wx:if="{{amountVisible}}" class="panel">
  <view class="panel__header">
    <text class="panel__title">{{amountTitle}}</text>
    <view class="panel__close" bindtap="closeAmount">关闭</view>
  </view>

  <scroll-view class="panel__body" scroll-y>
    <view class="panel__amount panel__amount--lg">
      <text class="panel__prefix panel__prefix--lg">¥</text>
      <input
        class="panel__input panel__input--lg"
        type="digit"
        placeholder="0.00"
        placeholder-class="panel__ph"
        value="{{amountValue}}"
        bindinput="onAmountInput"
      />
    </view>

    <view class="quick">
      <text
        wx:for="{{quickAmounts}}"
        wx:key="*this"
        class="quick__item num"
        data-value="{{item}}"
        bindtap="onQuickTap"
      >¥{{item}}</text>
    </view>
  </scroll-view>

  <view class="panel__footer">
    <view
      class="btn btn-primary panel__save {{amountSaving ? 'btn--disabled' : ''}}"
      hover-class="{{amountSaving ? '' : 'btn--hover'}}"
      bindtap="onAmountSave"
    >{{amountSaving ? '处理中…' : '确定'}}</view>
  </view>
</view>
