/* 自定义组件宿主默认 inline，需显式撑满，保证胶囊按行宽换行 */
:host {
  display: block;
  width: 100%;
}

.tc {
  width: 100%;
}

.tc__chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.tc__chip {
  display: inline-flex;
  align-items: center;
  /* §2.4 最小热区 88rpx：胶囊视觉上比文字大一圈，但仍低于 88，这里直接抬到合规值 */
  min-height: 88rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 0 var(--gap-sm2);
  border-radius: 999rpx;
  font-size: 24rpx;
  background-color: var(--color-brand-light);
  color: var(--color-brand-text);
}

.tc__chip.is-ghost {
  background-color: rgba(255, 255, 255, .06);
  color: var(--color-text-sub);
}

.tc__chip-text {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tc__chip-del {
  /* 嵌在胶囊内部的删除符号，热区同样补到 88rpx（父级 align-items 居中，不影响视觉） */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-left: var(--gap-xs2);
  font-size: 24rpx;
  color: var(--color-brand-text);
}

.tc__input-wrap {
  min-width: 200rpx;
  /* 与 88rpx 的 chip 同高，否则输入框会在标签行里显得矮一截 */
  height: 88rpx;
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tc__input {
  width: 100%;
  height: 88rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.tc__ph {
  color: var(--color-text-placeholder);
  font-size: 26rpx;
}

.tc__suggest {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.tc__suggest-label {
  margin: 0 12rpx 12rpx 0;
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.tc__empty {
  font-size: 24rpx;
  color: var(--color-text-hint);
}