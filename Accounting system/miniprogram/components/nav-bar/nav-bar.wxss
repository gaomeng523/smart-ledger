/* 自定义导航：高 44px，标题 18/600 左对齐，右侧为胶囊预留 ≥100px */
.nav {
  position: relative;
  z-index: 20;
  background-color: transparent;
}

.nav__bar {
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  box-sizing: border-box;
}

.nav__back {
  width: 88rpx;
  height: 88rpx;
  margin-left: -20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav__back--hover {
  background-color: rgba(255, 255, 255, .06);
}

.nav__title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text, #F2F3F5);
  line-height: 1.2;
}

.nav__spacer {
  flex: 1;
  min-width: 0;
}
